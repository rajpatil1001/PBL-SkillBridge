# SkillBridge AI/ML Skill Intelligence Service Environment Variables

# Service Config
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
SANITIZE_LOG_PII=true

# CORS Allowed Origins (Comma-separated or JSON list)
# Restrict to Express API and UI client in staging/production
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# Scoring Model Weights & Decay Parameters
DEFAULT_RECENCY_HALF_LIFE_DAYS=365
DEFAULT_RECENCY_FLOOR=0.25
CORROBORATION_BONUS_PER_SOURCE=0.08
MAX_CORROBORATION_BONUS=0.24

# Data File Paths (Optional overrides)
# TAXONOMY_PATH=app/data/taxonomy.json
# RESOURCES_PATH=app/data/resources.json
